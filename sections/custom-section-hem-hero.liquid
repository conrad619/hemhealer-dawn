{% liquid
  assign default_cta_link = routes.root_url | append: '/collections/frontpage' | replace: '//', '/'
  assign secondary_button_link = section.settings.secondary_button_link | default: default_cta_link
  assign bottom_button_link = section.settings.bottom_button_link | default: default_cta_link
%}

<div class='color-{{ section.settings.color_scheme }} twcss-overflow-hidden gradient'>
  <div class='custom-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding'>
    <div
      {% if section.settings.full_width %}
        class='page-width'
      {% endif %}
    >
      <div class='twcss-w-full twcss-pb-[5rem]'>
        <div class='twcss-pt-[5rem]'>
          {% if section.settings.heading_1 != blank %}
            <h2 class='lg:twcss-text-[4.5rem] twcss-text-[2.5rem] twcss-font-bold twcss-text-center'>
              {{ section.settings.heading_1 }}
            </h2>
          {% endif %}
          {% if section.settings.heading_2 != blank %}
            <h3 class='lg:twcss-text-[7rem] twcss-text-[3rem] twcss-text-center twcss-mb-[4rem]'>
              {{ section.settings.heading_2 }}
            </h3>
          {% endif %}

          <div class='hem-hero-testimonials twcss-grid lg:twcss-grid-cols-2 lg:twcss-gap-[3rem] twcss-gap-[2rem]'>
            {% for block in section.blocks %}
              {% liquid
                assign video_url = block.settings.video_url
                assign quote = block.settings.quote
                assign author = block.settings.author
              %}
              {% if video_url != blank or quote != blank or author != blank %}
                <div class='hem-hero-testimonial' {{ block.shopify_attributes }}>
                  {% if video_url != blank %}
                    <iframe
                      class='video-testimonial-iframe twcss-aspect-video'
                      src='{{ video_url }}'
                      width='100%'
                      style='aspect-ratio: 16/9;'
                      title='{{ author | default: "Customer testimonial" | escape }}'
                      loading='lazy'
                      allow='autoplay; fullscreen; picture-in-picture'
                      allowfullscreen
                    ></iframe>
                  {% endif %}
                  {% if quote != blank or author != blank %}
                    <p>
                      {% if quote != blank %}
                        {{ quote | newline_to_br }}
                      {% endif %}
                      {% if author != blank %}
                        <br>
                        {{ author }}
                      {% endif %}
                    </p>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- TrustBox widget - List -->
<div
  class='trustpilot-widget'
  data-locale='en-US'
  data-template-id='539ad60defb9600b94d7df2c'
  data-businessunit-id='68584b7dfbdd6383950293e7'
  data-style-height='900px'
  data-style-width='100%'
  data-token='fa1a9326-e551-461e-bf04-6ad6daa7b88c'
  data-stars='4,5'
  data-review-languages='en'
>
  <a href='https://www.trustpilot.com/review/hemhealer.com' target='_blank' rel='noopener'>Trustpilot</a>
</div>
<!-- End TrustBox widget -->
{% if section.settings.show_secondary_cta %}
  <div class='twcss-bg-[#4182a6]'>
    <div class='custom-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding'>
      <div
        {% if section.settings.full_width %}
          class='page-width'
        {% endif %}
      >
        <div class='twcss-w-full twcss-py-[5rem]'>
          {% if section.settings.secondary_heading != blank %}
            <h2 class='lg:twcss-text-[4.5rem] twcss-text-[2.5rem] twcss-text-center twcss-mb-[3rem] twcss-text-white twcss-font-body'>
              {{ section.settings.secondary_heading }}
            </h2>
          {% endif %}
          <div
            id='testimonial-images-{{ section.id }}'
            class='twcss-grid lg:twcss-grid-cols-2 lg:twcss-gap-[3rem] twcss-gap-[2rem]'
          >
            <div id='testimonial-images-left-{{ section.id }}'></div>
            <div id='testimonial-images-right-{{ section.id }}'></div>
          </div>
          <div class='twcss-text-center twcss-mt-[5rem]'>
            <a
              href='{{ secondary_button_link }}'
              class='twcss-text-white twcss-inline-block twcss-bg-[--accent-color] twcss-px-[2rem] twcss-py-[1.5rem] twcss-text-[2rem] twcss-leading-none'
            >
              <span class='twcss-flex'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  height='24px'
                  viewBox='0 -960 960 960'
                  width='24px'
                  fill='#ffffff'
                >
                  <path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM208-800h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Z"/>
                </svg>
                <span class='twcss-font-bold'>{{ section.settings.secondary_button_text }}</span>
              </span>
              {% if section.settings.guarantee_text != blank %}
                <span class='twcss-text-[1.4rem]'>{{ section.settings.guarantee_text }}</span>
              {% endif %}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% if section.settings.show_bottom_cta %}
  <div class='custom-section isolate{% unless section.settings.full_width %} page-width{% endunless %} section-{{ section.id }}-padding'>
    <style>
      .trustpilot-widget iframe{
        height:100vh !important;
      }
      @keyframes hemHeroPulseShadow-{{ section.id }} {
        0% {
          box-shadow: 0 0 0 0 rgba(0, 255, 38, 0.8);
        }
        70% {
          box-shadow: 0 0 0 30px rgba(216, 90, 48, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(216, 90, 48, 0);
        }
      }
      .hem-hero-cta-{{ section.id }} {
        animation: hemHeroPulseShadow-{{ section.id }} 1.5s ease-out infinite;
      }
    </style>
    <div class='twcss-text-center lg:twcss-my-[10rem] twcss-my-[5rem]'>
      <a
        href='{{ bottom_button_link }}'
        class='hem-hero-cta-{{ section.id }} twcss-text-white twcss-inline-block twcss-bg-[--accent-color] twcss-px-[4rem] twcss-py-[2rem] lg:twcss-text-[4rem] twcss-text-[2rem] twcss-leading-none twcss-rounded-lg'
      >
        <span class='twcss-flex'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 -960 960 960'
            fill='#ffffff'
            class='lg:twcss-w-[40px] lg:twcss-h-[40px] twcss-w-[20px] twcss-h-[20px]'
          >
            <path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM208-800h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Z"/>
          </svg>
          <span class='twcss-font-bold'>{{ section.settings.bottom_button_text }}</span>
        </span>
        {% if section.settings.guarantee_text != blank %}
          <span class='lg:twcss-text-[2.5rem] twcss-text-[1.5rem]'>
            {{- section.settings.guarantee_text -}}
          </span>
        {% endif %}
      </a>
    </div>
  </div>
{% endif %}

